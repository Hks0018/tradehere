# ==============================================================================
# Tradehere — market data engine configuration
#
# Copy to `.env.local` and fill in as needed. Every value below has a working
# default, so the platform runs on sample data with no .env file at all.
#
# NEVER commit real credentials. `.env.local` is git-ignored; this file is the
# documentation and must only ever contain empty or example values.
# ==============================================================================

# ---- Alpha Vantage -----------------------------------------------------------
# The integrated live provider. Server-side only: the engine is guarded by
# `server-only`, so importing it from client code fails the build rather than
# shipping the key to a browser. Never prefix this with NEXT_PUBLIC_.
#
# Verified capabilities on a free key:
#   quotes (US + BSE), daily history (US + BSE), symbol search, US fundamentals,
#   news with sentiment.
# Not available: intraday (premium), NIFTY/SENSEX index symbols, sector and
# market-breadth endpoints. Those keep using the sample provider.

ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_TIMEOUT_MS=8000

# Local ceiling on calls per UTC day. The engine stops here rather than
# discovering the limit by being refused. Free keys are commonly 25/day.
ALPHA_VANTAGE_DAILY_LIMIT=25

# Calls held back from bulk work so an interactive page view still gets real
# data late in the day.
ALPHA_VANTAGE_RESERVE=4

# ---- IndianAPI -----------------------------------------------------------
# indianapi.in — a third-party API marketplace reselling NSE/BSE data. NOT an
# exchange-authorized vendor: its own Terms of Service disclaim any accuracy or
# availability warranty and place responsibility for legal/regulatory
# compliance on the integrator rather than asserting a data license from NSE
# or BSE. See src/server/market-data/providers/indianapi/index.ts for the full
# caveat and verified capabilities.
#
# Auth is a plain `x-api-key` header (never a query param), so the key never
# ends up in a logged URL. Server-side only, same `server-only` guard as
# Alpha Vantage — never prefix this with NEXT_PUBLIC_.
#
# Base URL depends on the plan tier shown on the IndianAPI dashboard: Free and
# Hobby use stock.indianapi.in (the default below); Developer, Growth/Analyst
# and Pro tiers use dev./analyst./pro.indianapi.in respectively — change
# INDIANAPI_BASE_URL to match your key's tier.

INDIANAPI_API_KEY=
INDIANAPI_BASE_URL=https://stock.indianapi.in
INDIANAPI_TIMEOUT_MS=8000

# ---- NSE indices (official, unauthenticated) ----------------------------------
# Reads NSE's own published end-of-day indices-close report directly from its
# archive host. No key or signup: this is a public static file, unlike the
# interactive nseindia.com site and API, which sit behind bot detection a
# server-side request cannot pass.
#
# Covers only four of Tradehere's eight indices — NIFTY 50, NIFTY BANK, NIFTY
# MIDCAP 100 and NIFTY IT. SENSEX is a BSE index and the rest are global
# benchmarks, so those stay on the sample provider.
#
# This is the previous closing session, published once daily — never
# real-time. Every value is labelled DELAYED with the session date it refers
# to, the same honest treatment Alpha Vantage's EOD quotes already get.

NSE_ENABLED=true
NSE_ARCHIVE_BASE_URL=https://nsearchives.nseindia.com
NSE_TIMEOUT_MS=15000
# Calendar days to walk back for the last published session, to bridge
# weekends and holidays.
NSE_LOOKBACK_DAYS=10
# How long a resolved trading day is trusted before checking for a newer one.
NSE_RECHECK_MS=3600000

# ---- Live providers ----------------------------------------------------------
# Each provider stays completely inert until ENABLED, BASE_URL and API_KEY are
# all present. Once they are, the registry places it ahead of the sample
# provider automatically — no code change is required.
#
# Keys are read on the server only. They are never sent to the browser: the
# engine is guarded by `server-only`, so importing it from a client component
# fails the build rather than shipping a secret.

MARKET_PROVIDER_PRIMARY_ENABLED=false
MARKET_PROVIDER_PRIMARY_BASE_URL=
MARKET_PROVIDER_PRIMARY_API_KEY=
MARKET_PROVIDER_PRIMARY_TIMEOUT_MS=4000

MARKET_PROVIDER_SECONDARY_ENABLED=false
MARKET_PROVIDER_SECONDARY_BASE_URL=
MARKET_PROVIDER_SECONDARY_API_KEY=
MARKET_PROVIDER_SECONDARY_TIMEOUT_MS=4000

# ---- Provider priority -------------------------------------------------------
# Comma-separated provider ids, highest priority first, per capability.
# Unconfigured providers are skipped without counting as failures.
# Defaults to: primary,secondary,mock

MARKET_PRIORITY_QUOTES=alphavantage,indianapi,primary,secondary,mock
MARKET_PRIORITY_HISTORICAL=alphavantage,indianapi,primary,secondary,mock
MARKET_PRIORITY_SEARCH=alphavantage,indianapi,primary,mock
MARKET_PRIORITY_FUNDAMENTALS=alphavantage,indianapi,mock
MARKET_PRIORITY_NEWS=alphavantage,indianapi,mock
# NSE only implements the single-index `getIndex`, not the bulk `getIndices`,
# so listing it first cannot displace the complete eight-index sample list —
# it can only supply real figures for the four indices it publishes.
# Alpha Vantage publishes no NIFTY/SENSEX symbols and has no sector or breadth
# endpoints, so it never appears in these three.
MARKET_PRIORITY_INDICES=nse,primary,secondary,mock
MARKET_PRIORITY_SECTORS=mock
MARKET_PRIORITY_BREADTH=mock

# ---- Cache TTLs (milliseconds) -----------------------------------------------
# Short for anything that ticks, long for reference data.

# Tuned for a metered end-of-day provider. Lower these when a real-time
# provider is configured.
MARKET_TTL_QUOTE_MS=900000
MARKET_TTL_INDICES_MS=900000
MARKET_TTL_BREADTH_MS=900000
MARKET_TTL_SECTORS_MS=1800000
MARKET_TTL_HISTORICAL_MS=21600000
MARKET_TTL_SEARCH_MS=86400000
MARKET_TTL_PROFILE_MS=86400000
MARKET_TTL_INSTRUMENTS_MS=86400000
MARKET_TTL_NEWS_MS=21600000

# How long an expired value is retained so it can still answer as LAST_KNOWN
# when every provider is down. Default 24h.
MARKET_LAST_KNOWN_TTL_MS=86400000

# ---- Circuit breaker ---------------------------------------------------------
# Consecutive failures before a provider is skipped, how long it is skipped for,
# and how many trial successes close the circuit again.

MARKET_BREAKER_FAILURE_THRESHOLD=3
MARKET_BREAKER_COOLDOWN_MS=30000
MARKET_BREAKER_SUCCESS_THRESHOLD=1

# ---- Diagnostics -------------------------------------------------------------
# Logs provider selection, cache hits and failover. Defaults to on outside
# production. Logs contain provider ids and error codes only — never keys,
# URLs or upstream response bodies.
MARKET_DATA_DEBUG=true
