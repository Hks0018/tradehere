# ==============================================================================
# Tradehere — market data engine configuration
#
# Copy to `.env.local` and fill in as needed. Every value below has a working
# default, so the platform runs on sample data with no .env file at all.
#
# NEVER commit real credentials. `.env.local` is git-ignored; this file is the
# documentation and must only ever contain empty or example values.
# ==============================================================================

# ---- Live providers ----------------------------------------------------------
# Each provider stays completely inert until ENABLED, BASE_URL and API_KEY are
# all present. Once they are, the registry places it ahead of the sample
# provider automatically — no code change is required.
#
# Keys are read on the server only. They are never sent to the browser: the
# engine is guarded by `server-only`, so importing it from a client component
# fails the build rather than shipping a secret.

MARKET_PROVIDER_PRIMARY_ENABLED=false
MARKET_PROVIDER_PRIMARY_BASE_URL=
MARKET_PROVIDER_PRIMARY_API_KEY=
MARKET_PROVIDER_PRIMARY_TIMEOUT_MS=4000

MARKET_PROVIDER_SECONDARY_ENABLED=false
MARKET_PROVIDER_SECONDARY_BASE_URL=
MARKET_PROVIDER_SECONDARY_API_KEY=
MARKET_PROVIDER_SECONDARY_TIMEOUT_MS=4000

# ---- Provider priority -------------------------------------------------------
# Comma-separated provider ids, highest priority first, per capability.
# Unconfigured providers are skipped without counting as failures.
# Defaults to: primary,secondary,mock

MARKET_PRIORITY_QUOTES=primary,secondary,mock
MARKET_PRIORITY_HISTORICAL=primary,secondary,mock
MARKET_PRIORITY_INDICES=primary,secondary,mock
MARKET_PRIORITY_SEARCH=primary,mock
MARKET_PRIORITY_SECTORS=mock
MARKET_PRIORITY_BREADTH=mock
MARKET_PRIORITY_FUNDAMENTALS=mock

# ---- Cache TTLs (milliseconds) -----------------------------------------------
# Short for anything that ticks, long for reference data.

MARKET_TTL_QUOTE_MS=10000
MARKET_TTL_INDICES_MS=15000
MARKET_TTL_BREADTH_MS=30000
MARKET_TTL_SECTORS_MS=60000
MARKET_TTL_HISTORICAL_MS=300000
MARKET_TTL_SEARCH_MS=600000
MARKET_TTL_PROFILE_MS=1800000
MARKET_TTL_INSTRUMENTS_MS=3600000

# How long an expired value is retained so it can still answer as LAST_KNOWN
# when every provider is down. Default 24h.
MARKET_LAST_KNOWN_TTL_MS=86400000

# ---- Circuit breaker ---------------------------------------------------------
# Consecutive failures before a provider is skipped, how long it is skipped for,
# and how many trial successes close the circuit again.

MARKET_BREAKER_FAILURE_THRESHOLD=3
MARKET_BREAKER_COOLDOWN_MS=30000
MARKET_BREAKER_SUCCESS_THRESHOLD=1

# ---- Diagnostics -------------------------------------------------------------
# Logs provider selection, cache hits and failover. Defaults to on outside
# production. Logs contain provider ids and error codes only — never keys,
# URLs or upstream response bodies.
MARKET_DATA_DEBUG=true
